{
  "name": "glass-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local desktop agent workspace powered by Pi",
  "main": "desktop/main.mjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "electron .",
    "postinstall": "node scripts/prepare-native.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify:sdk": "node scripts/verify-sdk.mjs",
    "package:mac": "npm run build && node scripts/package-macos.mjs",
    "format": "prettier --write src desktop scripts tests docs .github README.md CONTRIBUTING.md AGENTS.md SECURITY.md THIRD_PARTY_NOTICES.md package.json vite.config.js",
    "check": "prettier --check src desktop scripts tests docs .github README.md CONTRIBUTING.md AGENTS.md SECURITY.md THIRD_PARTY_NOTICES.md package.json vite.config.js"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.41.0",
    "monaco-editor": "0.56.0",
    "node-pty": "^1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typebox": "^1.3.7"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.2.0",
    "prettier": "3.9.6",
    "vite": "^8.2.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Baker-Harrison/Glass.git"
  },
  "overrides": {
    "dompurify": "3.4.15"
  }
}
